  "control_and_identifiability_audit": {
    "positive_support_zh": "与分别采集单因素的资源不同，这个文档规格提供同一物理实例在光照×视角上的真实拍摄交叉网格。类别在这些同实例记录之间固定，五类Y非退化；可预先按同实例/固定camera/固定其余因子匹配记录。",
    "identifiable_finite_data_target": {
      "target_zh": "在已记录玩具和支持网格上的配对预测损失差，或预先指定两项控制变量的差中之差。",
      "example_formula": "Delta_f(l1,l0 | a,e,camera) = mean_i[loss(f(x_i(l1,a,e,camera)),Y_i)-loss(f(x_i(l0,a,e,camera)),Y_i)]",
      "interpretation_zh": "这是固定模型、固定物体集合和已记录条件上的经验对照；所有所需格点实际存在且配对正确后，可由记录直接计算，不必从不相关照片猜同一对象的反事实。",
      "computed_this_review": false
    },
    "conditional_lab_causal_interpretation_zh": "若信赖拍摄控制、格点标签和除指定设置外的稳定性，可把上述配对对照解释为这个固定实验装置/玩具集合内改变控制设置的总效应。页面未提供拍摄顺序、随机化、时间漂移或重复重拍信息，因而不能自动排除所有未记录变化并推广到自然总体。",
    "variables_not_independent_interventions": [
      {
        "variable": "category / instance",
        "boundary_zh": "物体固有属性与嵌套身份，不是随机处理；category和within-category实例号共同标识对象。把实例号8跨五类合并会混淆五个不同玩具。"
      },
      {
        "variable": "camera axis",
        "boundary_zh": "同一设置的两次视点测量，不是两个独立物理单位；相机内外参差异未知，不能把两幅图当纯传感器噪声重复。"
      },
      {
        "variable": "lighting condition",
        "boundary_zh": "0–5是六种照明条件的类别编码，不是已校准照度/曝光剂量，也不是独立通道增益；具体光源布置、光谱与剂量未由本页给出。"
      },
      {
        "variable": "elevation and azimuth",
        "boundary_zh": "有明确角度的控制坐标。全因子平衡不等于已证明拍摄顺序随机、物理效应可加或各潜在机制独立；2D软件变换也不等于这些3D视点变化。"
      }
    ],
    "not_identified_by_this_resource_alone": [
      "AA/RA/TA训练策略的收益或其因果机制；需要另有预注册且可比较的训练运行。",
      "未拍摄角度、连续照明剂量或任意do(Z=z)的响应。",
      "自然动物/真实部署环境总体的因果效应；固定玩具和实验装置不构成自然场景样本。",
      "任意类别或instance的独立处理效应；两者并非可互换的随机化控制变量。",
      "用从属视图数建立的高精度总体置信区间。"
    ],
    "independence_unit_zh": "跨对象泛化时以物理玩具(category,instance)为来源单位；官方test只有25个、每类5个，视图/相机/光照是同对象的重复测量。源ID区分也不自动建立总体i.i.d.或玩具模型来源独立性。"
  },
