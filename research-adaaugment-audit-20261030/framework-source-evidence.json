          "590: def reduce_storage(storage):",
          "591:     from . import get_sharing_strategy",
          "592: ",
          "593:     if storage.is_cuda:",
          "594:         raise RuntimeError(",
          "595:             \"Cannot pickle CUDA storage; try pickling a CUDA tensor instead\"",
          "596:         )",
          "597:     elif storage.device.type == \"meta\":",
          "598:         raise RuntimeError(",
          "599:             \"Cannot pickle meta storage; try pickling a meta tensor instead\"",
          "600:         )",
          "601:     elif get_sharing_strategy() == \"file_system\":",
          "602:         metadata = storage._share_filename_cpu_()",
          "603:         cache_key = metadata[1]",
          "604:         rebuild = rebuild_storage_filename",
          "605:         if isinstance(storage, torch.TypedStorage):",
          "606:             metadata += (storage.dtype,)",
          "607:         storage._shared_incref()",
          "608:     elif storage.size() == 0:",
          "609:         # This is special cased because Empty tensors",
          "610:         # (with size 0) cannot be mmapped.",
          "611:         return (rebuild_storage_empty, (type(storage),))",
          "612:     else:",
          "613:         fd, size = storage._share_fd_cpu_()",
          "614:         df = multiprocessing.reduction.DupFd(fd)",
          "615:         cache_key = fd_id(fd)",
          "616:         metadata = (df, size)",
          "617:         rebuild = rebuild_storage_fd  # type: ignore[assignment]",
          "618: ",
          "619:     shared_cache[cache_key] = StorageWeakRef(storage)",
          "620:     return (rebuild, (type(storage),) + metadata)",
          "621: ",
          "622: ",
          "623: def init_reductions():",
          "624:     reduction.register(torch.cuda.Event, reduce_event)",
          "625: ",
          "626:     for t in torch._storage_classes:",
          "627:         if t.__name__ == \"UntypedStorage\":",
          "628:             reduction.register(t, reduce_storage)",
          "629:         else:",
          "630:             reduction.register(t, reduce_typed_storage_child)",
          "631: ",
          "632:     reduction.register(torch.storage.TypedStorage, reduce_typed_storage)",
          "633: ",
          "634:     for t in torch._tensor_classes:",
          "635:         reduction.register(t, reduce_tensor)",
          "636: ",
          "637:     # TODO: Maybe this should be in tensor_classes? :)",
          "638:     reduction.register(torch.Tensor, reduce_tensor)",
          "639: ",
          "640:     from torch.nn.parameter import Parameter",
          "641: ",
          "642:     reduction.register(Parameter, reduce_tensor)"
        ]
