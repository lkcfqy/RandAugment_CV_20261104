          "1233:     def _reset(self, loader, first_iter=False) -> None:",
          "1234:         super()._reset(loader, first_iter)",
          "1235:         self._send_idx = 0  # idx of the next task to be sent to workers",
          "1236:         self._rcvd_idx = 0  # idx of the next task to be returned in __next__",
          "1237:         # information about data not yet yielded, i.e., tasks w/ indices in range [rcvd_idx, send_idx).",
          "1238:         # map: task idx => - (worker_id,)        if data isn't fetched (outstanding)",
          "1239:         #                  \\ (worker_id, data)   if data is already fetched (out-of-order)",
          "1240:         self._task_info = {}",
          "1241:         self._tasks_outstanding = (",
          "1242:             0  # always equal to count(v for v in task_info.values() if len(v) == 1)",
          "1243:         )",
          "1244:         # A list of booleans representing whether each worker still has work to",
          "1245:         # do, i.e., not having exhausted its iterable dataset object. It always",
          "1246:         # contains all `True`s if not using an iterable-style dataset",
          "1247:         # (i.e., if kind != Iterable).",
          "1248:         # Not that this indicates that a worker still has work to do *for this epoch*.",
          "1249:         # It does not mean that a worker is dead. In case of `_persistent_workers`,",
          "1250:         # the worker will be reset to available in the next epoch.",
          "1251:         self._workers_status = [True for i in range(self._num_workers)]",
