          "492:     def __iter__(self) -> _BaseDataLoaderIter:",
          "493:         # When using a single worker the returned iterator should be",
          "494:         # created every time to avoid resetting its state",
          "495:         # However, in the case of a multiple workers iterator",
          "496:         # the iterator is only created once in the lifetime of the",
          "497:         # DataLoader object so that workers can be reused",
          "498:         if self.persistent_workers and self.num_workers > 0:",
          "499:             if self._iterator is None:",
          "500:                 self._iterator = self._get_iterator()",
          "501:             else:",
          "502:                 self._iterator._reset(self)",
          "503:             return self._iterator",
          "504:         else:",
          "505:             return self._get_iterator()",
          "506: "
