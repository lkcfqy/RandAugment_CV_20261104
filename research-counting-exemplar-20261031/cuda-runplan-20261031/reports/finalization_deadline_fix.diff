+import contextlib,hashlib,os,queue,signal,subprocess,threading,time
 from pathlib import Path
 from contracts import PREFIX,decode_packet,validate_artifact_path
 from evidence import atomic_bytes
+
+class ComputeBudgetExpired(TimeoutError):
+    pass
+
+def remaining_timeout(deadline,original_timeout):
+    remaining=deadline-time.monotonic()
+    if remaining<=0:raise ComputeBudgetExpired('1800 s cumulative computation deadline exhausted')
+    return min(original_timeout,remaining)
+
+@contextlib.contextmanager
+def compute_deadline(deadline):
+    """OS wall timer interrupts blocking validation and waits, not an after-the-fact check."""
+    remaining=remaining_timeout(deadline,float('inf'))
+    if signal.getitimer(signal.ITIMER_REAL)[0]:raise RuntimeError('unexpected existing wall timer')
+    def expired(*args):raise ComputeBudgetExpired('1800 s cumulative computation deadline exhausted during finalization')
+    previous=signal.signal(signal.SIGALRM,expired)
+    signal.setitimer(signal.ITIMER_REAL,remaining)
+    try:yield
+    finally:
+        signal.setitimer(signal.ITIMER_REAL,0)
+        signal.signal(signal.SIGALRM,previous)
 
