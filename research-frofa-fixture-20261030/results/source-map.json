    "anchors": {
      "139": "def brightness_augmentation_v3(x, max_delta=0.1, aug_min_val=0, aug_max_val=1.0, ",
      "143": "    x_min_val, _ = torch.min(x, dim=1, keepdim=True)",
      "144": "    x_max_val, _ = torch.max(x, dim=1, keepdim=True)",
      "146": "    denorm = x_max_val - x_min_val + 1e-8",
      "150": "    delta = torch.empty(x_norm.shape[0], 1, x_norm.shape[2]).uniform_(-max_delta, max_delta).to(x_norm.device)",
      "155": "        x_norm = torch.clamp(x_norm, aug_min_val, aug_max_val)",
      "157": "    x_aug = x_norm * denorm + x_min_val"
    },
    "executed": false
  },
  {
    "path": "source/Network_vit.py.txt",
    "sha256": "a1e8dfbbf6d011ba1522ad3e64dd64cd72ed5daf5246e49df50dd164da2bf584",
    "git_blob_sha1": "d2ad2ba50e8c09bee825cb3fe064fda1299fea71",
    "anchors": {
      "221": "    def augment(self, x, delta):",
      "222": "        cls_token = x[:, 0, :]",
      "223": "        patch_token = x[:, 1:, :]",
      "224": "        aug_patch_token = brightness_augmentation_v3(patch_token, max_delta=delta)",
      "225": "        x_aug = torch.cat((cls_token.unsqueeze(1), aug_patch_token), dim=1)"
    },
    "executed": false
  }
